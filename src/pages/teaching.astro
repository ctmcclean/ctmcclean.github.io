---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

// Yale courses first, by `order`, each with its description and the most
// recent syllabus. Earlier teaching follows as a short list without descriptions.
const courses = (await getCollection('teaching')).sort((a, b) => a.data.order - b.data.order);
const yale = courses.filter((c) => c.data.institution === 'Yale University');
const earlier = courses.filter((c) => c.data.institution !== 'Yale University');
---

<Base title="Teaching" description="Courses taught by Charles T. McClean at Yale and elsewhere, with syllabi.">
  <header class="page-head">
    <p class="kicker">Teaching</p>
    <h1>Courses</h1>
    <p class="lede">Syllabi are the most recent version for each course.</p>
  </header>

  <h2>Yale University</h2>
  <ul class="works">
    {yale.map((c) => (
      <li>
        <div class="work-title">{c.data.course}</div>
        <div class="meta">
          {c.data.number && <>{c.data.number} · </>}{c.data.level} · {c.data.years}
          {c.data.planned && <> <span class="pill">Planned</span></>}
        </div>
        {c.data.description && <p class="desc">{c.data.description}</p>}
        {c.data.syllabus && (
          <div class="actions">
            <a class="btn" href={c.data.syllabus}>
              {c.data.planned ? 'Draft syllabus' : 'Syllabus'}{c.data.term && ` (${c.data.term})`}
            </a>
          </div>
        )}
      </li>
    ))}
  </ul>

  <h2>Earlier teaching</h2>
  <ul class="works compact">
    {earlier.map((c) => (
      <li>
        <div class="work-title">{c.data.course}</div>
        <div class="meta">{c.data.institution} · {c.data.level} · {c.data.years}</div>
      </li>
    ))}
  </ul>
</Base>

<style>
  .works li { padding: 1.4rem 0; }
  .desc { margin: 0.7rem 0 0; color: var(--ink-2); font-size: 1.02rem; max-width: var(--measure); }
  .actions { display: flex; gap: 0.75rem; margin-top: 0.9rem; flex-wrap: wrap; }
  .compact li { padding: 0.7rem 0; }
  .meta .pill { margin-left: 0.2rem; }
</style>
