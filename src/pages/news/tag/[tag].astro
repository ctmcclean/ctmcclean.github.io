---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import NewsItem from '../../../components/NewsItem.astro';

export async function getStaticPaths() {
  const posts = await getCollection('news');
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({
    params: { tag: tag.toLowerCase() },
    props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()) },
  }));
}
const { tag, posts } = Astro.props;
---

<Base title={`News · ${tag}`}>
  <header class="page-head">
    <p class="kicker"><a href="/news/">News</a></p>
    <h1>{tag}</h1>
  </header>
  <ul class="news-list">
    {posts.map((p) => <NewsItem post={p} variant="rich" />)}
  </ul>
</Base>
